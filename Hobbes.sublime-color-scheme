{
    "name": "Hobbes",
    "variables": {
        "orange_fur"  : "#d39f58",
        "white_fur"   : "#b1aea8",
        "hazel_eye"   : "#a19366",
        "pink_nose"   : "#ad8178",
        "red_tongue"  : "#a15953",
        "black_eye"   : "#201e22",
        "midnight"    : "color(var(black_eye) saturation(10%) lightness(20%))",
        "gray"        : "color(var(white_fur) blend(var(black_eye) 60%))",
        "catnip"      : "#869c78",
        "water"       : "#7587a6"
    },
    "globals": {
        "background"                    : "var(black_eye)",
        "gutter"                        : "var(black_eye)",
        "foreground"                    : "var(white_fur)",
        "caret"                         : "var(white_fur)",
        "invisibles"                    : "var(black_eye)",
        "line_highlight"                : "var(midnight)",
        "selection"                     : "var(midnight)",
        "selection_foreground"          : "var(orange_fur)",
        "selection_border"              : "var(water)",
        "selection_border_width"        : "0",
        "inactive_selection"            : "var(black_eye)",
        "inactive_selection_border"     : "var(gray)",
        "inactive_selection_foreground" : "var(water)",
        "accent"                        : "var(red_tongue)",
        "misspelling"                   : "var(red_tongue)",
        "guide"                         : "color(var(water) alpha(0.3))",
        "gutter_foreground"             : "color(var(white_fur) alpha(0.4))",
        "line_diff_added"               : "var(catnip)",
        "line_diff_modified"            : "var(red_tongue)",
        "line_diff_deleted"             : "var(red_tongue)",
        "find_highlight"                : "var(orange_fur)",
        "find_highlight_foreground"     : "var(black_eye)",
        "brackets_options"              : "underline",
        "bracket_contents_options"      : "underline",
        "tags_options"                  : "stippled_underline"
    },
    "rules": [
        {
            "name": "Tags",
            "scope": "meta.tag",
            "foreground": "gray"
        },
        {
            "name": "Comment",
            "scope": "comment, source.python.django comment.line.number-sign.python punctuation.definition.comment.python",
            "foreground": "var(gray)",
            "font_style": "italic"
        },
        {
            "name": "Keyword and Storage",
            "scope": "keyword, storage, constant, support.constant, meta.property-value, entity.name.tag, keyword.other.unit.css, keyword.operator.django, keyword.control.tag-name.django, variable.other.constant.python, keyword.operator | keyword.operator.logical.python | keyword.other.any",
            "foreground": "var(pink_nose)"
        },
        {
            "name": "Django template unquoted tag names",
            "scope": "text.html.django storage.type.templatetag.django string.unquoted.tag-string.django, text.html.django meta.tag.inline.any.html meta.attribute-with-value.id.html",
            "foreground": "var(water)"
        },
        {
            "name": "Django template quoted html",
            "scope": "text.html.django meta.tag.inline.any.html string.quoted.double.html, text.html.django meta.tag.block.any.html string.quoted.double.html, text.html.django meta.tag.any.html string.quoted.double.html",
            "foreground": "var(hazel_eye)"
        },
        {
            "name": "Variables and Entities",
            "scope": "variable, entity.other.attribute-name, support.other.namespace, support.class, support.type.property-name, meta.property-name, meta.instance.constructor",
            "foreground": "var(water)"
        },
        {
            "name": "Property Variables",
            "scope": "variable.other.property, meta.property.object, variable.annotation.python",
            "foreground": "var(water)"
        },
        {
            "name": "Separators",
            "scope": "meta.separator",
            "background": "var(gray)",
            "foreground": "var(gray)"
        },
        {
            "name": "Invalid",
            "scope": "invalid",
            "background": "var(red_tongue)",
            "foreground": "var(gray)"
        },
        {
            "name": "Punctuation",
            "scope": "keyword.operator | keyword.other.any | punctuation.(separator|definition|section|group).(begin|end|mapping|sequence|arguments).(python|json|) | source.python.django meta.string.python meta.interpolation.python punctuation.section.interpolation.(begin|end).python | meta.sequence.json | meta.group.braces.round.function.arguments",
            "foreground": "var(white_fur)"
        },
        {
            "name": "String and Keywords",
            "scope": "string.quoted.(single|double).(python|css)",
            "foreground": "var(hazel_eye)"
        },
        {
            "name": "JSON keys",
            "scope": "meta.mapping.key.json string.quoted.double.json",
            "foreground": "var(water)"
        },
        {
            "name": "JSON values",
            "scope": "meta.mapping.value.json string.quoted.double.json",
            "foreground": "var(hazel_eye)"
        },
        {
            "name": "Classes",
            "scope": "entity.other.attribute-name.class, entity.name.class.python, entity.other.inherited-class.python",
            "foreground": "var(orange_fur)"
        },
        {
            "name": "Functions",
            "scope": "variable.function, entity.name.function, meta.function-call, meta.function-call.arguments.python",
            "foreground": "var(catnip)"
        },
        {
            "name": "Python function arguments",
            "scope": "meta.function-call.arguments.python meta.path.python",
            "foreground": "var(water)"
        },
        {
            "name": "Python self",
            "scope": "source.python.django meta.path.python variable.language.python",
            "foreground": "var(red_tongue)"
        },
        {
            "name": "Support Functions",
            "scope": "support.function",
            "foreground": "var(catnip)"
        },
        {
            "name": "JavaScript in HTML - Keywords",
            "scope": "text.html source.js keyword, text.html source.js.embedded keyword, meta.tag.script source.js keyword",
            "foreground": "var(pink_nose)"
        },
        {
            "name": "JavaScript in HTML - Strings",
            "scope": "text.html source.js string, text.html source.js.embedded string, meta.tag.script source.js string",
            "foreground": "var(hazel_eye)"
        },
        {
            "name": "JavaScript in HTML - Functions",
            "scope": "text.html source.js entity.name.function, text.html source.js.embedded entity.name.function, meta.tag.script source.js entity.name.function, text.html source.js meta.function-call, text.html source.js.embedded meta.function-call",
            "foreground": "var(catnip)"
        },
        {
            "name": "JavaScript in HTML - Variables",
            "scope": "text.html source.js variable, text.html source.js.embedded variable, meta.tag.script source.js variable",
            "foreground": "var(water)"
        },
        {
            "name": "JavaScript in HTML - Comments",
            "scope": "text.html source.js comment, text.html source.js.embedded comment, meta.tag.script source.js comment",
            "foreground": "var(gray)",
            "font_style": "italic"
        },
        {
            "name": "JavaScript in HTML - Numbers",
            "scope": "text.html source.js constant.numeric, text.html source.js.embedded constant.numeric, meta.tag.script source.js constant.numeric",
            "foreground": "var(orange_fur)"
        },
        {
            "name": "JavaScript in HTML - Constants",
            "scope": "text.html source.js constant.language, text.html source.js.embedded constant.language, meta.tag.script source.js constant.language",
            "foreground": "var(pink_nose)"
        },
        {
            "name": "JavaScript in Django HTML - Keywords",
            "scope": "text.html.django source.js keyword, text.html.django source.js.embedded keyword",
            "foreground": "var(pink_nose)"
        },
        {
            "name": "JavaScript in Django HTML - Strings",
            "scope": "text.html.django source.js string, text.html.django source.js.embedded string",
            "foreground": "var(hazel_eye)"
        },
        {
            "name": "JavaScript in Django HTML - Functions",
            "scope": "text.html.django source.js entity.name.function, text.html.django source.js.embedded entity.name.function, text.html.django source.js meta.function-call, text.html.django source.js.embedded meta.function-call",
            "foreground": "var(catnip)"
        },
        {
            "name": "JavaScript in Django HTML - Variables",
            "scope": "text.html.django source.js variable, text.html.django source.js.embedded variable",
            "foreground": "var(water)"
        },
        {
            "name": "JavaScript in Django HTML - Constants",
            "scope": "text.html.django source.js constant.language, text.html.django source.js.embedded constant.language",
            "foreground": "var(pink_nose)"
        },
        {
            "name": "JavaScript in Django HTML - Numbers",
            "scope": "text.html.django source.js constant.numeric, text.html.django source.js.embedded constant.numeric",
            "foreground": "var(orange_fur)"
        },
        {
            "name": "JavaScript in Django HTML - Operators",
            "scope": "text.html.django source.js keyword.operator, text.html.django source.js.embedded keyword.operator",
            "foreground": "var(white_fur)"
        },
        {
            "name": "JavaScript in Django HTML - Fix tag detection in JS",
            "scope": "text.html.django source.js meta.tag, text.html.django source.js.embedded meta.tag, text.html.django source.js entity.name.tag, text.html.django source.js.embedded entity.name.tag",
            "foreground": "var(hazel_eye)"
        },
        {
            "name": "JavaScript in Django HTML - Fix string in JS",
            "scope": "text.html.django source.js string.quoted, text.html.django source.js.embedded string.quoted",
            "foreground": "var(hazel_eye)"
        },
        {
            "name": "JavaScript in Django HTML - Disable broken regex detection",
            "scope": "text.html.django source.js.embedded.html string.regexp, text.html.django source.js.embedded.html meta.string",
            "foreground": ""
        },
        {
            "name": "JavaScript in Django HTML - Fix strings in broken regex scope",
            "scope": "text.html.django source.js.embedded.html string.regexp string.quoted",
            "foreground": "var(hazel_eye)"
        },
        {
            "name": "JavaScript in Django HTML - Fix constant in broken regex scope",
            "scope": "text.html.django source.js.embedded.html string.regexp constant.other.character-class.set.regexp",
            "foreground": "var(white_fur)"
        },
        {
            "name": "JavaScript in Django HTML - Fix punctuation in broken regex scope",
            "scope": "text.html.django source.js.embedded.html string.regexp punctuation",
            "foreground": "var(white_fur)"
        },
        {
            "name": "JavaScript in Django HTML - Fix keyword in broken regex scope",
            "scope": "text.html.django source.js.embedded.html string.regexp keyword",
            "foreground": "var(white_fur)"
        },
        {
            "name": "JavaScript in Django HTML - Fix script tags in broken regex scope",
            "scope": "text.html.django source.js.embedded.html string.regexp meta.tag, text.html.django source.js.embedded.html string.regexp entity.name.tag, text.html.django source.js.embedded.html string.regexp punctuation.definition.tag",
            "foreground": "var(gray)"
        },
        {
            "name": "CSS in HTML - Properties",
            "scope": "text.html source.css meta.property-name, text.html source.css.embedded meta.property-name",
            "foreground": "var(water)"
        },
        {
            "name": "CSS in HTML - Values",
            "scope": "text.html source.css meta.property-value, text.html source.css.embedded meta.property-value",
            "foreground": "var(hazel_eye)"
        },
        {
            "name": "CSS in HTML - Selectors",
            "scope": "text.html source.css entity.name.tag, text.html source.css.embedded entity.name.tag",
            "foreground": "var(orange_fur)"
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric",
            "foreground": "var(orange_fur)"
        },
        {
            "name": "Constants",
            "scope": "constant.language, constant.character, constant.other",
            "foreground": "var(pink_nose)"
        },
        {
            "name": "Strings",
            "scope": "string",
            "foreground": "var(hazel_eye)"
        },
        {
            "name": "Operators",
            "scope": "keyword.operator.arithmetic, keyword.operator.assignment, keyword.operator.comparison, keyword.operator.logical",
            "foreground": "var(white_fur)"
        },
        {
            "name": "Control Keywords",
            "scope": "keyword.control",
            "foreground": "var(pink_nose)"
        },
        {
            "name": "Storage Type",
            "scope": "storage.type",
            "foreground": "var(pink_nose)"
        },
        {
            "name": "Storage Modifier",
            "scope": "storage.modifier",
            "foreground": "var(pink_nose)"
        },
        {
            "name": "Function Parameters",
            "scope": "variable.parameter, meta.parameter",
            "foreground": "var(water)"
        },
        {
            "name": "Language Variables",
            "scope": "variable.language",
            "foreground": "var(red_tongue)"
        },
        {
            "name": "Entity Name Type",
            "scope": "entity.name.type, entity.name.class, support.type, support.class",
            "foreground": "var(orange_fur)"
        },
        {
            "name": "Entity Name Section",
            "scope": "entity.name.section",
            "foreground": "var(orange_fur)"
        },
        {
            "name": "Inherited Class",
            "scope": "entity.other.inherited-class",
            "foreground": "var(orange_fur)"
        },
        {
            "name": "Support Variables and Constants",
            "scope": "support.variable, support.constant",
            "foreground": "var(pink_nose)"
        },
        {
            "name": "Markup Bold",
            "scope": "markup.bold",
            "foreground": "var(orange_fur)",
            "font_style": "bold"
        },
        {
            "name": "Markup Italic",
            "scope": "markup.italic",
            "foreground": "var(hazel_eye)",
            "font_style": "italic"
        },
        {
            "name": "Markup Underline",
            "scope": "markup.underline",
            "foreground": "var(water)",
            "font_style": "underline"
        },
        {
            "name": "Markup Heading",
            "scope": "markup.heading, entity.name.section",
            "foreground": "var(orange_fur)",
            "font_style": "bold"
        },
        {
            "name": "Markup List",
            "scope": "markup.list",
            "foreground": "var(water)"
        },
        {
            "name": "Markup Quote",
            "scope": "markup.quote",
            "foreground": "var(gray)",
            "font_style": "italic"
        },
        {
            "name": "Markup Raw/Code",
            "scope": "markup.raw, markup.inline.raw",
            "foreground": "var(catnip)"
        },
        {
            "name": "Markup Link",
            "scope": "markup.underline.link",
            "foreground": "var(water)",
            "font_style": "underline"
        },
        {
            "name": "Diff Header",
            "scope": "meta.diff, meta.diff.header",
            "foreground": "var(gray)",
            "font_style": "italic"
        },
        {
            "name": "Diff Deleted",
            "scope": "markup.deleted",
            "foreground": "var(red_tongue)"
        },
        {
            "name": "Diff Inserted",
            "scope": "markup.inserted",
            "foreground": "var(catnip)"
        },
        {
            "name": "Diff Changed",
            "scope": "markup.changed",
            "foreground": "var(orange_fur)"
        },
        {
            "name": "RegExp",
            "scope": "string.regexp",
            "foreground": "var(catnip)"
        },
        {
            "name": "RegExp Character Class",
            "scope": "string.regexp constant.character.escape",
            "foreground": "var(orange_fur)"
        },
        {
            "name": "Escape Characters",
            "scope": "constant.character.escape",
            "foreground": "var(orange_fur)"
        },
        {
            "name": "Embedded Source",
            "scope": "source.embedded",
            "foreground": "var(white_fur)"
        }
    ]
}
